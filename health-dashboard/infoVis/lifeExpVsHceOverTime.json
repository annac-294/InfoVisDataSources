{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Ireland Started Below the UK and US and Overtook Both,", 
      "While Spending Less Than Half than the US" 
    ],
    "subtitle": [
      "",
      "Each dot is one year. Dashed segments are 2019-2021 (Covid-19).",
      "The ringed dot is the year chosen on the slider.",
      ""
    ],
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "subtitlePadding": 6
  },
  "data": {
    "url": "https://raw.githubusercontent.com/annac-294/InfoVisDataSources/main/health_main.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "spend_per_person_usd": "number",
        "life_expectancy": "number",
        "population": "number"
      }
    }
  },
  "params": [
    {
      "name": "pick",
      "value": null
    },
    {
      "name": "year_slider",
      "value": 2019
    }
  ],
  "transform": [
    {
      "filter": "datum.spend_per_person_usd > 0"
    },
    {
      "filter": "datum.life_expectancy > 0"
    },
    {
      "filter": "indexof(['Ireland', 'UK', 'US'], datum.label) >= 0 || datum.label == pick"
    },
    {
      "calculate": "indexof(['Ireland', 'UK', 'US'], datum.label) >= 0 ? datum.label : 'Your pick'",
      "as": "line_group"
    }
  ],
  "width": 520,
  "height": 280,
  "encoding": {
    "x": {
      "field": "spend_per_person_usd",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "nice": false,
        "padding": 95
      },
      "axis": {
        "title": "Health spending per person (US$, log scale)",
        "format": "$,.0f",
        "values": [50,100,200,500,1000,2000,3000,5000,10000,15000]
      }
    },
    "y": {
      "field": "life_expectancy",
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": false,
        "padding": 15
      },
      "axis": {
        "title": "Life expectancy at birth (years)"
      }
    },
    "color": {
      "field": "line_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Ireland",
          "UK",
          "US",
          "Your pick"
        ],
        "range": [
          "#1baf7a",
          "#2a78d6",
          "#eb6834",
          "#444444"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.year <= 2019"
        }
      ],
      "mark": {
        "type": "line"
      },
      "encoding": {
        "order": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year >= 2019"
        }
      ],
      "mark": {
        "type": "line",
        "strokeDash": [
          4, 3
        ]
      },
      "encoding": {
        "order": {
          "field": "year",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 50,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "label",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "spend_per_person_usd",
            "type": "quantitative",
            "title": "Spend per person ($)",
            "format": ",.0f"
          },
          {
            "field": "life_expectancy",
            "type": "quantitative",
            "title": "Life expectancy",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == year_slider"
        }
      ],
    "mark": {
      "type": "circle",
      "size": 260,
      "filled": false,
      "strokeWidth": 2.5,
      "opacity": 1
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2000"
        },
        {
          "calculate": "datum.label + ' 2000'",
          "as": "start_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": 4,
        "fontWeight": "bold",
        "fontSize": 12,
        "stroke": "white",
        "strokeWidth": 4
      },
      "encoding": {
        "text": {
          "field": "start_label",
          "type": "nominal"
        },
        "color": {
          "value": "white"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2000"
        },
        {
          "calculate": "datum.label + ' 2000'",
          "as": "start_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": 4,
        "fontWeight": "bold",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "start_label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2021"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 4,
        "fontWeight": "bold",
        "fontSize": 12,
        "stroke": "white",
        "strokeWidth": 4
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2021"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 4,
        "fontWeight": "bold",
        "fontSize": 12
      },
     "encoding": {
       "text": {
       "field": "year",
       "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 14,
      "titlePadding": 10,
      "gridColor": "#eeeeee",
      "gridWidth": 0.5
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "view": {
      "stroke": null
    },
    "background": null
  }
}