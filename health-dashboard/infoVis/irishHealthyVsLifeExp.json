{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Up to 2019, Ireland's Extra Years Were Healthy Years",
    "subtitle": [
      "",
      "Healthy life years +6.4, life expectancy +4.2 (2004-2019), so years in poor health shrank.",
      "The survey method changed in 2020, so later years (faded) can't be compared with earlier ones.",
      "Life expectancy here is from Eurostat, so differs slightly from other charts.", 
      ""
    ],
    "anchor": "start",
    "fontSize": 15, 
    "subtitleFontSize": 12,
    "subtitlePadding" : 6
  },
  "width": 700,
  "height": 240,
  "data": {
    "url": "https://raw.githubusercontent.com/annac-294/InfoVisDataSources/main/healthy_life_years.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "healthy_life_years": "number",
        "life_expectancy": "number"
      }
    }
  },
  "transform": [
    {"filter": "datum.country_name == 'Ireland'"},
    {"filter": "datum.sex == 'Total'"},
    {
      "calculate": "datum.year <= 2019 ? 'Before 2020' : 'From 2020'",
      "as": "period"
    },
    {
      "fold": ["life_expectancy", "healthy_life_years"],
      "as": ["measure_column", "years"]
    },
    {
      "calculate": "datum.measure_column == 'life_expectancy' ? 'Life expectancy' : 'Healthy life years'",
      "as": "measure"
    }
  ],
  "layer": [
    {
      "mark": {"type": "rule", "strokeDash": [4, 4], "color": "grey"},
      "encoding": {
        "x": {
          "datum": 2019.5,
          "type": "quantitative",
          "scale": {"domain": [2004, 2024]}
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline":"bottom",
        "y": -6,
        "fontSize": 12,
        "color": "grey"
      },
      "encoding": {
        "x": {
          "datum": 2019.5,
          "type": "quantitative",
          "scale": {"domain": [2004, 2024]}
        },
        "text": {"value": "Survey method changed (2020)"}
      }
    },
    {
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {"domain": [2004, 2024]},
          "axis": {
            "title": null,
            "format": "d",
            "values": [2004, 2008, 2012, 2016, 2019, 2024]
          }
        },
        "y": {
          "field": "years",
          "type": "quantitative",
          "scale": {"domain": [60, 85]},
          "axis": {
            "title": "Years (axis starts at 60)",
            "values": [60, 65, 70, 75, 80, 85]
          }
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": ["Life expectancy", "Healthy life years"],
            "range": ["#444444", "#1baf7a"]
          },
          "legend": null
        }, 
        "opacity":{
            "field":"period", 
            "type":"nominal", 
            "scale":{"domain":["Before 2020", "From 2020"], "range":[1, 0.5]},
            "legend":null
        }
      },
      "layer": [
        {
          "mark": {"type": "line", "strokeWidth": 2.5},
          "encoding": {"detail": {"field": "period", "type": "nominal"}}
        },
        {
          "mark": {"type": "circle", "size": 40, "opacity": 1},
          "encoding": {
            "tooltip": [
              {"field": "year", "type": "ordinal", "title": "Year"},
              {"field": "measure", "type": "nominal", "title": "Measure"},
              {
                "field": "years",
                "type": "quantitative",
                "title": "Years",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "transform": [{"filter": "datum.year == 2024"}],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "fontSize": 12,
            "fontWeight": "bold"
          },
          "encoding": {"text": {"field": "measure", "type": "nominal"}}
        }
      ]
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 14,
      "titlePadding": 10,
      "gridColor": "#eeeeee",
      "gridWidth": 1
    },
    "view": {"stroke": null}, 
    "background":null
  }, 
  "params": [{ "name": "pick", "value": null }
  ]
}